rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'virenknsl@gmail.com'
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'name', 'email', 'role', 'bio', 'tier', 'credits',
        'savedIdeaIds', 'unlockedIdeaIds', 'upvotedIdeaIds', 'joinedAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'name', 'email', 'role', 'bio', 'tier', 'credits',
        'savedIdeaIds', 'unlockedIdeaIds', 'upvotedIdeaIds', 'joinedAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
      data.role in ['Idea Giver', 'Idea Taker', 'Hybrid Creator'] &&
      data.bio is string && data.bio.size() <= 400 &&
      data.tier in ['free', 'pro'] &&
      data.credits is number && data.credits >= 0 && data.credits <= 100000 &&
      data.savedIdeaIds is list && data.savedIdeaIds.size() <= 200 &&
      (data.savedIdeaIds.size() == 0 || data.savedIdeaIds[0] is string) &&
      data.unlockedIdeaIds is list && data.unlockedIdeaIds.size() <= 200 &&
      (data.unlockedIdeaIds.size() == 0 || data.unlockedIdeaIds[0] is string) &&
      data.upvotedIdeaIds is list && data.upvotedIdeaIds.size() <= 500 &&
      (data.upvotedIdeaIds.size() == 0 || data.upvotedIdeaIds[0] is string) &&
      data.joinedAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidIdea(data) {
      return data.keys().hasAll([
        'id', 'title', 'category', 'summary', 'detailedDescription', 'secretPitch',
        'executionRoadmap', 'targetAudience', 'collaborationModel', 'askingTerms',
        'isPremium', 'unlockCredits', 'authorId', 'authorName', 'authorRole',
        'authorHandle', 'upvotes', 'tags', 'isFeatured', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'title', 'category', 'summary', 'detailedDescription', 'secretPitch',
        'executionRoadmap', 'targetAudience', 'collaborationModel', 'askingTerms',
        'isPremium', 'unlockCredits', 'authorId', 'authorName', 'authorRole',
        'authorHandle', 'upvotes', 'tags', 'isFeatured', 'boostCredits',
        'featuredAt', 'isDeleted', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.title is string && data.title.size() >= 6 && data.title.size() <= 140 &&
      data.category in [
        'Creator Economy & Regional Content',
        'Local & D2C Businesses',
        'Student & EdTech Hacks',
        'Local Services & Automation'
      ] &&
      data.summary is string && data.summary.size() >= 20 && data.summary.size() <= 320 &&
      data.detailedDescription is string && data.detailedDescription.size() >= 40 && data.detailedDescription.size() <= 2500 &&
      data.secretPitch is string && data.secretPitch.size() >= 25 && data.secretPitch.size() <= 2000 &&
      data.executionRoadmap is list && data.executionRoadmap.size() <= 10 &&
      (data.executionRoadmap.size() == 0 || data.executionRoadmap[0] is string) &&
      data.targetAudience is string && data.targetAudience.size() >= 4 && data.targetAudience.size() <= 160 &&
      data.collaborationModel in ['Equity Split', 'Fixed Buyout', 'Revenue Share', 'Co-Founder Search'] &&
      data.askingTerms is string && data.askingTerms.size() >= 3 && data.askingTerms.size() <= 120 &&
      data.isPremium is bool &&
      data.unlockCredits is number && data.unlockCredits >= 0 && data.unlockCredits <= 25 &&
      isValidId(data.authorId) &&
      data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
      data.authorRole is string && data.authorRole.size() <= 60 &&
      data.authorHandle is string && data.authorHandle.size() <= 60 &&
      data.upvotes is number && data.upvotes >= 0 && data.upvotes <= 1000000 &&
      data.tags is list && data.tags.size() <= 10 &&
      (data.tags.size() == 0 || data.tags[0] is string) &&
      data.isFeatured is bool &&
      (!('boostCredits' in data) || (data.boostCredits is number && data.boostCredits in [10, 15])) &&
      (!('featuredAt' in data) || (data.featuredAt is string && data.featuredAt.size() <= 40)) &&
      (!('isDeleted' in data) || data.isDeleted is bool) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidProposal(data) {
      return data.keys().hasAll([
        'id', 'ideaId', 'ideaAuthorId', 'senderId', 'senderName',
        'roleOffering', 'proposedTerms', 'message', 'status', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'ideaId', 'ideaAuthorId', 'senderId', 'senderName',
        'roleOffering', 'proposedTerms', 'message', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.ideaId) &&
      isValidId(data.ideaAuthorId) &&
      isValidId(data.senderId) &&
      data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 80 &&
      data.roleOffering is string && data.roleOffering.size() >= 3 && data.roleOffering.size() <= 100 &&
      data.proposedTerms is string && data.proposedTerms.size() >= 3 && data.proposedTerms.size() <= 120 &&
      data.message is string && data.message.size() >= 20 && data.message.size() <= 1200 &&
      data.status in ['Pending', 'In Review', 'Accepted'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPaymentRequest(data) {
      return data.keys().hasAll([
        'id', 'userId', 'userName', 'userEmail', 'packId', 'packType',
        'credits', 'amountInr', 'priceLabel', 'utr', 'status', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'id', 'userId', 'userName', 'userEmail', 'packId', 'packType',
        'credits', 'amountInr', 'priceLabel', 'utr', 'status',
        'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 80 &&
      data.userEmail is string && data.userEmail.size() >= 5 && data.userEmail.size() <= 160 &&
      data.packId in ['pack-50', 'pack-100', 'pack-500', 'pro-tier-pass'] &&
      data.packType in ['credits', 'pro'] &&
      data.credits is number && data.credits in [25, 50, 100, 500] &&
      data.amountInr is number && data.amountInr in [150, 400, 499, 1500] &&
      data.priceLabel is string && data.priceLabel.size() >= 2 && data.priceLabel.size() <= 20 &&
      data.utr is string && data.utr.matches('^[0-9]{12}$') &&
      data.status in ['Pending Verification', 'Approved', 'Rejected'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp &&
      (!('reviewedAt' in data) || data.reviewedAt is timestamp) &&
      (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128));
    }

    // --- Connection Probe ---
    match /test/connection {
      allow get: if true;
    }

    // --- Admin Registry ---
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) &&
        request.auth.token.email == 'virenknsl@gmail.com' &&
        incoming().keys().hasAll(['uid', 'email', 'grantedAt']) &&
        incoming().keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().grantedAt == request.time;
      allow update, delete: if false;
    }

    // --- User Profiles & Credit Wallets ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().tier == 'free' &&
        incoming().credits == 5 &&
        incoming().savedIdeaIds.size() == 0 &&
        incoming().unlockedIdeaIds.size() == 0 &&
        incoming().upvotedIdeaIds.size() == 0 &&
        incoming().joinedAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().joinedAt == existing().joinedAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().tier == existing().tier && (
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'bio', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['savedIdeaIds', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['upvotedIdeaIds', 'updatedAt']) ||
              (incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'unlockedIdeaIds', 'updatedAt']) &&
                incoming().credits <= existing().credits) ||
              (incoming().diff(existing()).affectedKeys().hasOnly(['credits', 'updatedAt']) &&
                incoming().credits < existing().credits)
            )
          )
        );

      allow delete: if false;
    }

    // --- Public Marketplace Ideas ---
    match /ideas/{ideaId} {
      allow get: if isValidId(ideaId);
      allow list: if true;

      allow create: if isVerifiedUser() && isValidId(ideaId) &&
        isValidIdea(incoming()) &&
        incoming().id == ideaId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            incoming().authorId == request.auth.uid &&
            incoming().upvotes == 1 &&
            (!('isDeleted' in incoming()) || incoming().isDeleted == false) && (
              !incoming().isFeatured || (
                'boostCredits' in incoming() &&
                incoming().boostCredits in [10, 15] &&
                getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.credits <=
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.credits - incoming().boostCredits
              )
            )
          )
        );

      allow update: if isVerifiedUser() && isValidId(ideaId) &&
        isValidIdea(incoming()) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'updatedAt']) &&
              (incoming().upvotes == existing().upvotes + 1 || incoming().upvotes == existing().upvotes - 1)) ||
            (existing().authorId == request.auth.uid &&
              !existing().isFeatured &&
              incoming().isFeatured == true &&
              'boostCredits' in incoming() &&
              incoming().boostCredits in [10, 15] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isFeatured', 'boostCredits', 'featuredAt', 'updatedAt']) &&
              getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.credits <=
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.credits - incoming().boostCredits)
          )
        );

      allow delete: if isValidId(ideaId) && isAdmin();
    }

    // --- Collaboration Proposals ---
    match /proposals/{proposalId} {
      allow get: if isValidId(proposalId);
      allow list: if true;

      allow create: if isVerifiedUser() && isValidId(proposalId) &&
        isValidProposal(incoming()) &&
        incoming().id == proposalId &&
        incoming().senderId == request.auth.uid &&
        incoming().status == 'Pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() && isValidId(proposalId) &&
        isValidProposal(incoming()) &&
        incoming().id == existing().id &&
        incoming().ideaId == existing().ideaId &&
        incoming().ideaAuthorId == existing().ideaAuthorId &&
        incoming().senderId == existing().senderId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().ideaAuthorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(proposalId) && isAdmin();
    }

    // --- FamPay / UPI UTR Payment Verification Queue ---
    match /paymentRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        isAdmin() || existing().userId == request.auth.uid
      );

      allow list: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      allow create: if isVerifiedUser() && isValidId(requestId) &&
        isValidPaymentRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().userId == request.auth.uid &&
        incoming().userEmail == request.auth.token.email &&
        incoming().status == 'Pending Verification' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        !('reviewedAt' in incoming()) &&
        !('reviewedBy' in incoming());

      allow update: if isAdmin() && isValidId(requestId) &&
        isValidPaymentRequest(incoming()) &&
        existing().status == 'Pending Verification' &&
        incoming().status in ['Approved', 'Rejected'] &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().userName == existing().userName &&
        incoming().userEmail == existing().userEmail &&
        incoming().packId == existing().packId &&
        incoming().packType == existing().packType &&
        incoming().credits == existing().credits &&
        incoming().amountInr == existing().amountInr &&
        incoming().priceLabel == existing().priceLabel &&
        incoming().utr == existing().utr &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'updatedAt']);

      allow delete: if isValidId(requestId) && isAdmin();
    }
  }
}
